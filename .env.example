# Local development environment
DATABASE_URL="postgresql://forma:forma@localhost:5434/forma_intake?schema=public"
DIRECT_URL="postgresql://USER:PASS@HOST/DB"  # direct (non-pooled) connection, used for migrations

# Auth — 32+ char secret used to sign session JWTs (HS256).
AUTH_SECRET="replace-with-openssl-rand-hex-32"

# Public base URL of the platform (used to build embed snippets).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mock adapters: when true, no external API keys are required and all
# non-image vendor calls are simulated with deterministic fake data.
USE_MOCK_ADAPTERS="true"

# Image generation: "huggingface" (free w/ token, reliable), "pollinations"
# (free, no key, best-effort), or "mock" (offline).
IMAGE_PROVIDER="pollinations"
HUGGINGFACE_API_TOKEN=""

# Real vendor keys (only read when USE_MOCK_ADAPTERS=false) — leave blank for now.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
SENDGRID_API_KEY=""
CALENDLY_API_TOKEN=""
